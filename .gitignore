# Environment
.env
.env.local
*.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/

# Output
# Whole directory, not just *.xlsx: the write-back sidecar (<name>.sha256)
# carries the delivery digest, which per FEATURE_ONBOARDING §6 lives in the
# tag annotation and must never be committed to a tracked file.
output/
output-modern/

# Node
node_modules/
.next/

# Playwright artefacts
frontend/test-results/
frontend/playwright-report/
frontend-modern/test-results/
frontend-modern/playwright-report/
playwright-report/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
.coverage
*.tsbuildinfo

# Playwright MCP scratch
.playwright-mcp/

# Claude Code scratch
.claude/

# Local sample data / fixtures (do not commit)
docs/temp/
docs/test/

# Spec index: 原始 spec 檔與預處理快取（可能含機敏資料）
spec-index/sources/*
spec-index/cache/*
spec-index/manifest.json
!spec-index/sources/.gitkeep
!spec-index/cache/.gitkeep

# Local trash staged for manual deletion
_to_delete/

# Intake drop zone: customer source documents, same policy as <Feature>/inputs/.
# Only the human-authored ruling sheets are tracked.
_intake/*
!_intake/*/
_intake/*/*
!_intake/*/RULINGS.md

# Packaged spec-derived working set (rebuildable, may contain customer spec data)
# 套件自身的規則見 tcgen_package/.gitignore
tcgen_package.zip

# Per-feature lint reports (regenerable; `lint_tcs.py --json-report`). Each
# feature's own .gitignore already excludes `lint_report.json` and travels with
# the directory — these two lines are the repo-level backstop for a feature
# scaffolded without one, and for the pre-2026-08-11 root-level layout.
lint_report.json
*/lint_report.json
features/*/lint_report.json

# FW form templates: blank/reference form files stay untracked (company
# documents, same policy as <Feature>/inputs/); only the manifest is tracked.
forms/*
!forms/FORMS.md
# R-G14 (2026-08-24): the全案 lookup-miss ledger lives in forms/ and must
# be tracked. The reference databases themselves (DBC/PROXI/LID, R-G12)
# stay untracked like every other company document here.
!forms/LOOKUP_MISSES.md
!forms/.gitkeep

# R-G2 (2026-08-17) moved three superseded 036 forms here with `mv`. The move
# must not change their TRACKING status: they are the same company documents
# that `forms/*` above keeps out of git, so the same rule extends here.
# Their SHA256 stays in forms/FORMS.md, which is tracked.
# NOTE (superseded by R-U12, 2026-08-17): archiving preserved the FILES, not
# their hashes-in-git — the three sat outside every BASELINE.sha256 for a whole
# round and nothing said so (see features/user_profiles/docs/upstream/
# 01_intake.md §2.4, and 02_rulings_execution.md §4). R-U12 closes that gap:
# BASELINE.sha256 now covers the three and is EXEMPTED below.
#
# The xlsx stay untracked (company documents, same rule as forms/* above); the
# checksum file must not — a hash kept only on disk protects nothing, which is
# the very thing R-U12 says: keeping the file and keeping its hash are two
# different things.
archive/forms_superseded/*
!archive/forms_superseded/.gitkeep
!archive/forms_superseded/BASELINE.sha256
