# Spec index: 原始 spec 檔與預處理快取（可能含機敏資料）
spec-index/sources/*
spec-index/cache/*
spec-index/manifest.json
!spec-index/sources/.gitkeep
!spec-index/cache/.gitkeep

# Local trash staged for manual deletion
_to_delete/

# Packaged spec-derived working set (rebuildable, may contain customer spec data)
# 套件自身的規則見 tcgen_package/.gitignore
tcgen_package.zip
