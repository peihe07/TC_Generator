# Customer source files - never commit
inputs/

# Derived from customer source material — never commit. This is the full
# CFTS019 spec text pdftotext extracts from inputs/, so it carries the same
# confidentiality as the PDF itself while being regenerable in one command.
data/cfts019_text.txt

# Regenerable artifacts (rebuilt by the Step 1 scripts). Add this feature's
# own data/*.json artefacts here as Step 1 starts emitting them.
data/recon.json
batches/
lint_report.json

# data/leaves.tsv IS tracked on purpose: recon only surveys the representative
# SWE.1 sheet (paths_meta.a03_sheet), so this file — not RECON.md — is the
# authority for the 318-leaf set R-AM5 rules in scope. A diff on it is the
# signal that the SWE.1 export moved underneath us.

# data/spec_id_to_outline.tsv IS tracked on purpose where a feature builds
# one: it is the traceability lookup every spec_reference is linted against,
# and a diff on it is the signal that the spec export moved underneath us.

# Local noise
__pycache__/
*.pyc
output/
.DS_Store
