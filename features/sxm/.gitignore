__pycache__/
*.pyc
output/
.DS_Store

# Rendered spec figure pages (25 MB of PNG regenerated from the PDF in
# inputs/ by build_stla_map/figure render — derived, and customer artwork).
data/figures/

# Carry customer prose rather than derived structure — same policy as inputs/.
data/stla_to_cfts.json
data/exemplars.json
data/unallocated_clauses.json
data/stla_id_suspects.json
